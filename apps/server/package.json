{
  "name": "@nautink/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local Node bridge between the Nautink web app and the user's Claude Code CLI.",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
