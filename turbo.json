{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "tsconfig.base.json",
    "vitest.shared.config.ts",
    "eslint.config.ts",
    ".prettierrc.json",
    ".prettierignore",
    ".npmrc",
    ".nvmrc",
    "tools/eslint-plugin-local/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // The web build also writes dist/third-party-licenses.txt with a root script, so that script is
    // an input too.
    "@nautink/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/generate-third-party-notices.ts",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": ["dist/**"]
    },
    // @nautink/ui's Storybook as a static site: a few seconds, so it runs in `pnpm check`.
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      // Turbo 2 runs tasks in strict environment mode and strips anything not declared here.
      // Add each variable a test reads as it appears.
      "env": ["NODE_ENV"]
    },
    // Dev servers never finish and never produce a cacheable result.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#typecheck:tooling": {
      "inputs": ["scripts/**", "tools/**", ".claude/hooks/**", "*.ts", "tsconfig*.json"],
      "outputs": []
    },
    // The web app's gzip budgets (docs/conventions.md), read from the build it depends on.
    "//#check:bundle-budget": {
      "dependsOn": ["@nautink/web#build"],
      "inputs": ["scripts/check-bundle-budget.ts"],
      "outputs": []
    },
    // The license gate and THIRD_PARTY_NOTICES.md freshness (scripts/generate-third-party-notices.ts).
    "//#check:licenses": {
      "inputs": [
        "scripts/generate-third-party-notices.ts",
        "THIRD_PARTY_NOTICES.md",
        "pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}", "scripts/**", "tools/**"],
      "outputs": []
    }
  }
}
