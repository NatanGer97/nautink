{
  "name": "nautink",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@nautink/web --filter=@nautink/server",
    "dev:web": "pnpm --filter @nautink/web dev",
    "dev:server": "pnpm --filter @nautink/server dev",
    "check": "turbo run lint typecheck:tooling typecheck test build check:bundle-budget",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:file": "node scripts/lint-file.ts",
    "lint:fixtures": "node scripts/check-lint-fixtures.ts",
    "lint:agent-hook": "node scripts/check-agent-hook.ts",
    "lint:changeset": "node scripts/check-changeset.ts",
    "check:agents": "node scripts/check-agent-hook.ts && node scripts/check-agent-parity.ts",
    "agents:sync": "node scripts/check-agent-parity.ts --write",
    "agents:install-prompts": "node scripts/install-agent-prompts.ts",
    "test:coverage-gate": "node scripts/check-coverage-gate.ts",
    "test:changeset-gate": "node --test scripts/check-changeset.test.ts",
    "check:bundle-budget": "node scripts/check-bundle-budget.ts",
    "test:bundle-budget-gate": "node --test scripts/check-bundle-budget.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck:tooling": "tsc -p tsconfig.json"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,jsonc,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
